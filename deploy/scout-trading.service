[Unit]
Description=Scout Trading Telegram bot with Codex CLI research
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=scout
Group=scout
WorkingDirectory=/opt/scout-trading
Environment=HOME=/var/lib/scout
Environment=CODEX_HOME=/var/lib/scout/.codex
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/scout-trading/.venv/bin/python -m scout bot --env-file /etc/scout-trading/env
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=control-group
UMask=0077
StateDirectory=scout
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scout
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
