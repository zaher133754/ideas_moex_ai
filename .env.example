# Токен хранить только здесь, не присылать в чат.
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram user ID. Другие пользователи не получают доступ.
TELEGRAM_OWNER_ID=
# Личный chat ID обычно равен user ID. Можно оставить пустым и выполнить /start.
TELEGRAM_CHAT_ID=
DATA_DIR=./data
TIMEZONE=Europe/Samara
SEND_TIME=09:00
RESEARCH_TIME=08:00
FRESH_HOURS=48
QUOTE_MAX_HOURS=96
DEDUP_DAYS=90
REPORT_SIZE=10
MIN_SCORE=65
MIN_RR=1.5
MIN_DAILY_TURNOVER_RUB=1000000
MAX_ENTRY_DISTANCE_PCT=3
COMMISSION_BPS=5
CODEX_MODEL=
CODEX_BIN=codex
CODEX_TIMEOUT_SECONDS=900
ALLOW_SHORTS=true
ALLOW_FUTURES=true
MAX_IDEA_LEVERAGE=5
